<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\BlitzRelay.Protocol\*.cs" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="LiteNetLib" Version="2.1.4" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Flavour)' == 'slim'">
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Flavour)' == 'standalone'">
        <PublishAot>false</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Flavour)' == 'native'">
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <Target Name="ValidateFlavour" BeforeTargets="Build" Condition="'$(Flavour)' != ''">
        <Error Condition="'$(Flavour)' != 'slim' and '$(Flavour)' != 'standalone' and '$(Flavour)' != 'native'" Text="Unknown Flavour '$(Flavour)'. Expected: slim, standalone, or native." />
    </Target>

</Project>
